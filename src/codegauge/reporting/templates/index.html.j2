<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>CodeGauge Report Portal</title>
    <link rel="stylesheet" href="{{ assets_prefix }}/report.css" />
    <script defer src="{{ assets_prefix }}/theme.js"></script>
  </head>
  <body>
    <div class="header-row">
      <h1>CodeGauge Report Portal</h1>
      <div class="actions">
        <button class="btn" type="button" data-theme-toggle>Theme: Dark</button>
      </div>
    </div>
    <p class="subtle">Generated at {{ summary.generated_at }}</p>

    <table>
      <tbody>
        <tr><th>Project Count</th><td>{{ summary.project_count }}</td></tr>
        <tr><th>PASS / WARN / FAIL</th><td>{{ summary.pass_count }} / {{ summary.warn_count }} / {{ summary.fail_count }}</td></tr>
        <tr><th>Average Score</th><td>{% if summary.average_score is not none %}{{ "%.2f"|format(summary.average_score) }}{% else %}n/a{% endif %}</td></tr>
      </tbody>
    </table>

    <h2>Language Distribution</h2>
    <table>
      <thead>
        <tr><th>Language</th><th>Projects</th></tr>
      </thead>
      <tbody>
        {% for language, count in summary.language_distribution.items() %}
        <tr><td>{{ language }}</td><td>{{ count }}</td></tr>
        {% else %}
        <tr><td colspan="2">No language metadata available.</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <table>
      <thead>
        <tr>
          <th>Project</th>
          <th>Score</th>
          <th>Grade</th>
          <th>Policy</th>
          <th>Critical</th>
          <th>High</th>
          <th>Medium</th>
          <th>Low</th>
          <th>Trend</th>
        </tr>
      </thead>
      <tbody>
        {% for row in projects %}
        <tr>
          <td><a href="projects/{{ row.project }}/index.html">{{ row.project }}</a></td>
          <td>{{ "%.2f"|format(row.score) }}</td>
          <td>{{ row.grade or "-" }}</td>
          <td class="status-{{ row.policy_status }}">{{ row.policy_status|upper }}</td>
          <td>{{ row.critical }}</td>
          <td>{{ row.high }}</td>
          <td>{{ row.medium }}</td>
          <td>{{ row.low }}</td>
          <td>{% if row.trend_delta is not none %}{{ "%+.2f"|format(row.trend_delta) }}{% else %}n/a{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </body>
</html>
