<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>CodeGauge Project - {{ project }}</title>
    <style>
      body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; margin: 2rem; color: #1f2937; }
      table { border-collapse: collapse; width: 100%; margin-bottom: 1rem; }
      th, td { border: 1px solid #d1d5db; padding: 0.5rem; text-align: left; }
      th { background: #f3f4f6; }
      .status-fail { color: #b91c1c; font-weight: 600; }
      .status-warn { color: #92400e; font-weight: 600; }
      .status-pass { color: #166534; font-weight: 600; }
      .mono { font-family: Menlo, Monaco, Consolas, "Liberation Mono", monospace; }
    </style>
  </head>
  <body>
    <p><a href="../../index.html">Back to portal</a></p>
    <h1>Project: {{ project }}</h1>

    {% if runs %}
    <p>
      Latest status:
      <span class="status-{{ runs[0].policy_status }}">{{ runs[0].policy_status|upper }}</span>
      | Score: {{ "%.2f"|format(runs[0].overall_score) }}
      | Grade: {{ runs[0].grade or "-" }}
    </p>
    {% endif %}

    <h2>Runs</h2>
    <table>
      <thead>
        <tr>
          <th>Generated</th>
          <th>Policy</th>
          <th>Score</th>
          <th>Grade</th>
          <th>Critical</th>
          <th>High</th>
          <th>Medium</th>
          <th>Low</th>
          <th>Reason Codes</th>
          <th>Artifacts</th>
        </tr>
      </thead>
      <tbody>
        {% for run in runs %}
        <tr>
          <td class="mono" title="{{ run.generated_at }}">{{ run.generated_local }}</td>
          <td class="status-{{ run.policy_status }}">{{ run.policy_status|upper }}</td>
          <td>{{ "%.2f"|format(run.overall_score) }}</td>
          <td>{{ run.grade or "-" }}</td>
          <td>{{ run.critical }}</td>
          <td>{{ run.high }}</td>
          <td>{{ run.medium }}</td>
          <td>{{ run.low }}</td>
          <td class="mono">{{ run.reason_codes|join(", ") if run.reason_codes else "-" }}</td>
          <td>
            <a href="{{ run.report_link }}">report.html</a>
            <a href="{{ run.summary_link }}">summary.json</a>
            <a href="{{ run.findings_link }}">findings.json</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </body>
</html>
