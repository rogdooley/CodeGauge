<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>CodeGauge Report - {{ project }}</title>
    <link rel="stylesheet" href="{{ assets_prefix }}/report.css" />
    <script defer src="{{ assets_prefix }}/theme.js"></script>
  </head>
  <body>
    <div class="card">
      <div class="row">
        <div>
          <h1 class="title">{{ project }}</h1>
          <div class="muted mono">{{ generated_local }}{% if generated_at %} ({{ generated_at }}){% endif %}</div>
        </div>
        <div class="actions">
          <a class="btn primary" href="{{ links.details }}">View Details</a>
          <a class="btn" href="{{ links.summary }}">JSON</a>
          <a class="btn" href="{{ links.findings }}">Findings</a>
          <a class="btn" href="{{ links.raw }}">Raw</a>
          <a class="btn" href="{{ links.history }}">History</a>
          <a class="btn" href="{{ links.latest }}">Latest</a>
          <button class="btn" type="button" data-theme-toggle>Theme: Dark</button>
        </div>
      </div>
    </div>

    <div class="card">
      {% set policy_class = "policy-" + (policy_status|lower) %}
      {% set grade_class = "grade-" + (grade|string) %}
      <div class="score-grid">
        <div class="score"><div class="label">Score</div><div class="value">{{ "%.2f"|format(score) }}</div></div>
        <div class="score"><div class="label">Grade</div><div class="value {{ grade_class }}">{{ grade or "-" }}</div></div>
        <div class="score {{ policy_class }}"><div class="label">Policy</div><div class="value">{{ policy_status }}</div></div>
        <div class="score">
          <div class="label">Delta</div>
          {% if delta is not none %}
          <div class="value {{ 'delta-up' if delta >= 0 else 'delta-down' }}">{{ "%+.2f"|format(delta) }}</div>
          {% else %}
          <div class="value">n/a</div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Executive Summary</h2>
      <p>{{ action_plan.executive_summary or "No executive summary available." }}</p>
    </div>

    <div class="two-col">
      <div class="card">
        <h2>Top Recommendations</h2>
        <ul>
          {% for rec in action_plan.top_recommendations %}
          <li><strong>{{ rec.priority }}</strong> - {{ rec.title }}</li>
          {% else %}
          <li>No recommendations.</li>
          {% endfor %}
        </ul>
        <h2>Quick Wins</h2>
        <ul>
          {% for rec in action_plan.quick_wins %}
          <li>{{ rec.title }} ({{ rec.effort }})</li>
          {% else %}
          <li>No quick wins.</li>
          {% endfor %}
        </ul>
      </div>
      <div class="card">
        <h2>Security Concerns</h2>
        <ul>
          {% for item in action_plan.security_concerns or [] %}
          <li>{{ item.title if item.title is defined else item }}</li>
          {% else %}
          <li>No security concerns.</li>
          {% endfor %}
        </ul>
        <h2>Architecture Concerns</h2>
        <ul>
          {% for item in action_plan.architectural_concerns or [] %}
          <li>{{ item.title if item.title is defined else item }}</li>
          {% else %}
          <li>No architectural concerns.</li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="card">
      <h2>Key Metrics</h2>
      <table>
        <thead><tr><th>Metric</th><th>Value</th></tr></thead>
        <tbody>
          {% for key, value in key_metrics.items() %}
          <tr>
            <td class="mono">{{ key }}</td>
            <td>
              {% if value is mapping %}
              <table>
                <thead><tr><th>Key</th><th>Count</th></tr></thead>
                <tbody>
                  {% for sub_key, sub_value in value.items() %}
                  <tr><td class="mono">{{ sub_key }}</td><td>{{ sub_value }}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
              {% else %}
              {{ value }}
              {% endif %}
            </td>
          </tr>
          {% else %}
          <tr><td colspan="2">No scalar metrics.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </body>
</html>
