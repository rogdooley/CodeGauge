<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>CodeGauge Details - {{ project }}</title>
    <link rel="stylesheet" href="{{ assets_prefix }}/report.css" />
    <script defer src="{{ assets_prefix }}/theme.js"></script>
  </head>
  <body>
    <div class="card">
      <div class="row">
        <div>
          <h1 style="margin:0;">{{ project }}</h1>
          <div class="mono muted">{{ generated_local }}{% if generated_at %} ({{ generated_at }}){% endif %}</div>
        </div>
        <div class="actions">
          <a class="btn" href="../../index.html">Back to Portfolio</a>
          <a class="btn primary" href="{{ links.raw }}">Download Bundle</a>
          <a class="btn" href="{{ links.summary }}">summary.json</a>
          <a class="btn" href="{{ links.findings }}">findings.json</a>
          <a class="btn" href="{{ links.action_plan }}">action-plan.json</a>
          <a class="btn" href="#raw-artifacts">Raw Artifacts</a>
          <button class="btn" type="button" data-theme-toggle>Theme: Dark</button>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="stats">
        <div class="stat"><div class="label">Score</div><div class="value">{{ "%.2f"|format(score) }}</div></div>
        <div class="stat"><div class="label">Grade</div><div class="value">{{ grade or "-" }}</div></div>
        <div class="stat policy-{{ policy_status }}"><div class="label">Policy</div><div class="value">{{ policy_status }}</div></div>
        <div class="stat"><div class="label">Findings</div><div class="value">{{ total_findings }}</div></div>
        <div class="stat"><div class="label">Security</div><div class="value">{{ security_total }}</div></div>
        <div class="stat"><div class="label">Delta</div><div class="value">{% if trend.delta is not none %}{{ "%+.2f"|format(trend.delta) }}{% else %}n/a{% endif %}</div></div>
      </div>
      <div class="stats" style="margin-top:0.55rem;">
        <div class="stat"><div class="label">Debt</div><div class="value">{{ debt }}</div></div>
        <div class="stat"><div class="label">Scanner Failures</div><div class="value">{{ scanner_failures }}</div></div>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <h2>Action Plan</h2>
        <h3>Highest Priority</h3>
        <ul>
          {% for rec in action_plan.top_recommendations or [] %}
          <li><a href="{{ links.details }}#raw-artifacts">{{ rec.title }}</a> — Priority: {{ "%.1f"|format(rec.priority_score|default(0.0)) }}</li>
          {% else %}
          <li>No high-priority recommendations.</li>
          {% endfor %}
        </ul>
      </div>
      <div class="card">
        <h2>Security Summary</h2>
        <table>
          <tbody>
            <tr><th>Runtime</th><td>{{ security_groups.runtime|length }}</td></tr>
            <tr><th>Tooling</th><td>{{ security_groups.tooling|length }}</td></tr>
            <tr><th>Test-only</th><td>{{ security_groups.test_only|length }}</td></tr>
            <tr><th>False positives</th><td>{{ security_groups.false_positive|length }}</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2>Top Affected Files</h2>
      <table>
        <thead><tr><th>File</th><th>Findings</th></tr></thead>
        <tbody>
          {% for row in most_affected_files %}
          <tr><td class="mono"><a href="{{ links.findings }}">{{ row.file }}</a></td><td>{{ row.count }}</td></tr>
          {% else %}
          <tr><td colspan="2">No file-level findings.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <h2>Clustered Findings (Severity-First)</h2>
    <table>
      <thead><tr><th>Severity</th><th>Category</th><th>Message Family</th><th>Count</th><th>Example Files</th></tr></thead>
      <tbody>
        {% for row in clusters %}
        <tr>
          <td>{{ row.severity }}</td>
          <td>{{ row.category }}</td>
          <td>{{ row.message_family }}</td>
          <td>{{ row.count }}</td>
          <td class="mono">{{ row.example_files|join(", ") if row.example_files else "-" }}</td>
        </tr>
        {% else %}
        <tr><td colspan="5">No clustered findings.</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h2>Security Findings by Classification</h2>
    <h3>Runtime</h3>
    <table>
      <thead><tr><th>Severity</th><th>Rule</th><th>File</th><th>Line</th><th>Weight</th><th>Message</th></tr></thead>
      <tbody>
        {% for row in security_groups.runtime %}
        <tr><td>{{ row.severity }}</td><td class="mono">{{ row.rule_id }}</td><td class="mono">{{ row.file }}</td><td>{{ row.line if row.line is not none else "-" }}</td><td>{{ row.score_weight }}</td><td>{{ row.message }}</td></tr>
        {% else %}
        <tr><td colspan="6">No runtime security findings.</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h3>Tooling</h3>
    <table>
      <thead><tr><th>Severity</th><th>Rule</th><th>File</th><th>Line</th><th>Weight</th><th>Message</th></tr></thead>
      <tbody>
        {% for row in security_groups.tooling %}
        <tr><td>{{ row.severity }}</td><td class="mono">{{ row.rule_id }}</td><td class="mono">{{ row.file }}</td><td>{{ row.line if row.line is not none else "-" }}</td><td>{{ row.score_weight }}</td><td>{{ row.message }}</td></tr>
        {% else %}
        <tr><td colspan="6">No tooling security findings.</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h3>Test-only</h3>
    <table>
      <thead><tr><th>Severity</th><th>Rule</th><th>File</th><th>Line</th><th>Weight</th><th>Message</th></tr></thead>
      <tbody>
        {% for row in security_groups.test_only %}
        <tr><td>{{ row.severity }}</td><td class="mono">{{ row.rule_id }}</td><td class="mono">{{ row.file }}</td><td>{{ row.line if row.line is not none else "-" }}</td><td>{{ row.score_weight }}</td><td>{{ row.message }}</td></tr>
        {% else %}
        <tr><td colspan="6">No test-only security findings.</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h3>False Positive (Non-actionable)</h3>
    <table>
      <thead><tr><th>Severity</th><th>Rule</th><th>File</th><th>Line</th><th>Weight</th><th>Message</th></tr></thead>
      <tbody>
        {% for row in security_groups.false_positive %}
        <tr><td>{{ row.severity }}</td><td class="mono">{{ row.rule_id }}</td><td class="mono">{{ row.file }}</td><td>{{ row.line if row.line is not none else "-" }}</td><td>{{ row.score_weight }}</td><td>{{ row.message }}</td></tr>
        {% else %}
        <tr><td colspan="6">No false positives.</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h2>Findings by Severity</h2>
    <table>
      <thead><tr><th>Severity</th><th>Count</th></tr></thead>
      <tbody>
        {% for severity, count in severity_counts.items() %}
        <tr><td>{{ severity }}</td><td>{{ count }}</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h2>Rule Family Breakdown</h2>
    <table>
      <thead><tr><th>Rule Family</th><th>Count</th></tr></thead>
      <tbody>
        {% for row in rule_families %}
        <tr><td class="mono">{{ row.rule_family }}</td><td>{{ row.count }}</td></tr>
        {% else %}
        <tr><td colspan="2">No rule families.</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="grid-2">
      <div class="card">
        <h2>Inventory</h2>
        <table>
          <tbody>
            <tr><th>Files Seen</th><td>{{ runtime.inventory.files_seen if runtime.inventory is mapping else "-" }}</td></tr>
            <tr><th>First Party</th><td>{{ runtime.inventory.first_party if runtime.inventory is mapping else "-" }}</td></tr>
            <tr><th>Excluded</th><td>{{ runtime.inventory.excluded if runtime.inventory is mapping else "-" }}</td></tr>
            <tr><th>Generated</th><td>{{ runtime.inventory.generated if runtime.inventory is mapping else "-" }}</td></tr>
            <tr><th>Third Party</th><td>{{ runtime.inventory.third_party if runtime.inventory is mapping else "-" }}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="card">
        <h2>Parser Health</h2>
        <table>
          <tbody>
            <tr><th>Schema errors</th><td>{{ parser_health.get("CODEGAUGE.PARSER.SCHEMA_ERROR", 0) if parser_health is mapping else "-" }}</td></tr>
            <tr><th>Invalid path</th><td>{{ parser_health.get("CODEGAUGE.PARSER.INVALID_PATH", 0) if parser_health is mapping else "-" }}</td></tr>
            <tr><th>Missing rule id</th><td>{{ parser_health.get("CODEGAUGE.PARSER.MISSING_RULE_ID", 0) if parser_health is mapping else "-" }}</td></tr>
            <tr><th>Unhandled</th><td>{{ parser_health.get("CODEGAUGE.PARSER.UNHANDLED", 0) if parser_health is mapping else "-" }}</td></tr>
            <tr><th>Status</th><td>{{ "Healthy" if parser_health is mapping and parser_health.get("CODEGAUGE.PARSER.SCHEMA_ERROR", 0) == 0 and parser_health.get("CODEGAUGE.PARSER.INVALID_PATH", 0) == 0 and parser_health.get("CODEGAUGE.PARSER.UNHANDLED", 0) == 0 else "Attention Needed" }}</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <h2>Trend vs Previous Run</h2>
    <table>
      <tbody>
        <tr><th>Current Score</th><td>{{ "%.2f"|format(trend.current_score) }}</td></tr>
        <tr><th>Previous Score</th><td>{% if trend.previous_score is not none %}{{ "%.2f"|format(trend.previous_score) }}{% else %}n/a{% endif %}</td></tr>
        <tr><th>Delta</th><td>{% if trend.delta is not none %}{{ "%+.2f"|format(trend.delta) }}{% else %}n/a{% endif %}</td></tr>
      </tbody>
    </table>

    <h2 id="raw-artifacts">Raw Artifact Links</h2>
    <ul>
      <li><a href="{{ links.summary }}">summary.json</a></li>
      <li><a href="{{ links.findings }}">findings.json</a></li>
      <li><a href="{{ links.action_plan }}">action-plan.json</a></li>
      <li><a href="{{ links.inventory }}">inventory.json</a></li>
      <li><a href="{{ links.policy_resolution }}">policy-resolution.json</a></li>
      <li><a href="{{ links.score }}">score.json</a></li>
      <li><a href="{{ links.policy }}">policy.json</a></li>
      <li><a href="{{ links.manifest }}">run_manifest.json</a></li>
    </ul>
  </body>
</html>
